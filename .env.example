# Copy to .env and replace every change-me value. Existing .env is not overwritten.
BIND_ADDRESS=127.0.0.1
POSTGRES_USER=development
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=development
MINIO_USER=development
MINIO_PASSWORD=change-me-minio
# Set a tested tag or digest before running Compose.
MINIO_IMAGE=
MONGO_IMAGE=
MONGO_USER=admin
MONGO_PASSWORD=change-me-mongo
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
RABBIT_MQ_USER=development
RABBIT_MQ_PASSWORD=change-me-rabbitmq
DEVELOPMENT_NETWORK=development
# MediaMTX: choose an image compatible with the checked-in mediamtx.yml.
MEDIAMTX_IMAGE=
MEDIAMTX_PUBLIC_HOST=127.0.0.1
MEDIAMTX_JWKS_URL=http://keycloak:8080/realms/mediamtx/protocol/openid-connect/certs
CAMERA_RTSP_URL=rtsp://rtsp-server:8554/camera?jwt=replace-with-valid-token
